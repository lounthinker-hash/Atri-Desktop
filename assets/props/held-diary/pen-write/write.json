        65
      ]
    },
    "source_rect_formula": "left=(k%columns)*tile_width; top=(k//columns)*tile_height. Copy this tile to book_rect.left/top. Tile already includes all earlier marks; do not stack successive tiles."
  },
  "timeline": {
    "fps": 24,
    "count": 102,
    "duration_seconds": 4.25,
    "book_layer_order": [
      "empty-loop page (or original_stowed_page for stowed=true)",
      "current persistent ink tile",
      "one transformed pen only if stowed=false",
      "loop-front if loop_in_front=true and stowed=false"
    ],
    "hand_registration": "barrel_contact=true 时让主实现绘制的握笔指腹在 grip 附近夹住笔杆，后方手指先画、笔后再画前方指尖。barrel_contact=false 时笔已由笔套约束，人物接近/松开时可自行补前后帧。",
    "rigid_transform": "rotation_cw is clockwise in y-down space. For any pen-local p, book-space position = frame.tip + R(rotation_cw)*(p-pen.tip). The pen may extend above the book tile during withdrawal; avoid clipping to the page. Drawing the complete arm/pen on the sprite or stage uses this same transform.",
    "registration_note": "书脊和书格的位置与既有持书循环完全相同。stowed=true 用原作带笔开本，加当前 ink_tile；其余帧使用净版、墨层和一支移动的笔。",
    "wrist_elbow_motion": "Three contacts are unchanged in timing and ink location. In-air intervals lift away from the sheet. Barrel pitch and wrist pitch vary separately; the elbow rounds and settles slightly behind the wrist. Each frame supplies the actual pen grip/nib coordinates."
  },
